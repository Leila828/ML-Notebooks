            "[1,] -0.9287679  9.444710e-01 0.893855 0.4107813 -0.6876914\n",
            "[2,]  1.1278485 -4.286264e-16 3.000000 3.6055513 -0.9287679\n",
            "[1] \"--- Task 4: Function examples ---\"\n",
            "[1]  4 10 18\n"
          ]
        },
